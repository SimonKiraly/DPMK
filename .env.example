# ── MHD Košice — environment variables ───────────────────────────────────────
# Copy to `.env` and fill in as needed. `.env` is git-ignored.

# ── Backend (Railway) — live vehicle data ────────────────────────────────────
#   • Public base URL of our backend proxy. NOT a secret (no API key).
#   • The app also hard-defaults to this exact value, so `.env` is OPTIONAL for
#     normal use — override it only to point at a local/staging backend.
#   • Consumed at bundle time by src/constants/config.ts (EXPO_PUBLIC_* vars are
#     inlined by Metro).
EXPO_PUBLIC_API_BASE_URL=https://dpmk-production.up.railway.app

#   Feature flag for the backend. `false` = ignore the backend entirely and use
#   the direct Ubian / sample-data path only (pre-backend behaviour). Anything
#   else (or unset) = enabled.
EXPO_PUBLIC_USE_BACKEND_API=true

# Google Maps API key.
#   • NOT needed for development in Expo Go, or for any iOS build (Apple Maps).
#   • Needed ONLY for a production Android build (Google Play), where
#     react-native-maps uses Google Maps.
#   • Consumed by app.config.js -> android.config.googleMaps.apiKey.
#   • Prefer an EAS secret over a committed value:  eas secret:create
GOOGLE_MAPS_API_KEY=
