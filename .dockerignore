# Build context for the root Dockerfile is the repo root. The image only ever
# COPYs backend/{package*.json,tsconfig.json,src}. Keep everything heavy or
# app-specific — above all the Expo / React Native app and all node_modules —
# out of the context so builds are fast and never pull in the mobile app.

**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo

.git
.github
.gitignore
.gitattributes

# Expo / React Native app at the repo root (not part of the backend image)
.expo
.export-check
assets
docs
scripts
src
web-build
android
ios
App.tsx
index.ts
app.json
app.config.js
babel.config.js
metro.config.js
eas.json

# editor / local
.claude
.vscode
.idea
*.log
.DS_Store
.env
.env.*
