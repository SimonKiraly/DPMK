# ── MHD Košice backend — environment ─────────────────────────────────────────
# Copy to `.env` for local dev. On Railway set these in the service Variables tab.
# Every var has a sensible default; the backend runs with an empty .env.
#
# NOTHING here is secret today — the Ubian feed needs no key. Secrets only appear
# later (an official DPMK/Ubian credential, an app<->backend token, Sentry DSN);
# when they do they live ONLY here / in Railway, never in the mobile app.

# HTTP
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Upstream — Ubian navigation API (public, unauthenticated)
UBIAN_BASE_URL=https://dpmk-odchody.ubian.sk
UBIAN_TIMEOUT_MS=9000

# Fleet query — centre + radius of the /navigation/vehicles/nearby call.
# Same values the mobile app uses today (src/constants/config.ts): Košice city
# centre, 2600 m. Ubian returns the surrounding fleet (~100 vehicles) which is
# then filtered to Košice MHD.
FLEET_LAT=48.7204
FLEET_LNG=21.2577
FLEET_RADIUS_M=2600

# Background poller
VEHICLE_POLL_MS=10000          # fetch Ubian vehicles this often
POLLER_IDLE_STOP_MS=120000     # pause polling after this long with no /api/vehicles traffic

# CORS — comma-separated origins, or "*" (native apps send no Origin, so * is fine)
CORS_ORIGINS=*

# Per-IP rate limit on THIS backend
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
